# Токен бота от @BotFather
BOT_TOKEN=

# Числовые id чатов админов через запятую (узнать: отправить боту /id)
ADMIN_CHAT_IDS=

# Часовой пояс, в котором указано время мероприятий
TIMEZONE=Europe/Minsk

# За сколько дней напоминать и во сколько по местному времени
REMIND_DAYS=2,1
REMIND_AT=10:00

# За сколько часов напоминать (можно несколько через запятую)
REMIND_HOURS=2
