# Токен бота от @BotFather
BOT_TOKEN=

# Числовые id чатов админов через запятую (узнать: отправить боту /id)
ADMIN_CHAT_IDS=

# Часовой пояс, в котором указано время мероприятий
TIMEZONE=Europe/Minsk

# За сколько дней напоминать и во сколько (можно несколько времён через запятую)
REMIND_DAYS=2,1
REMIND_AT=10:00,22:00

# За сколько часов напоминать (можно несколько через запятую)
REMIND_HOURS=2

# Напоминание старше этого окна не отправляется (защита от дублей после перезапуска)
REMIND_WINDOW_MINUTES=360

# Публичный URL сервиса (на Render подставляется автоматически, локально — для webhook)
BOT_URL=
